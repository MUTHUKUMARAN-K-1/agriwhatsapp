# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice IDs (get these from ElevenLabs dashboard)
# You can use the same voice ID for all languages initially
ELEVENLABS_VOICE_ID=your_default_voice_id
ELEVENLABS_VOICE_ID_TAMIL=your_tamil_voice_id
ELEVENLABS_VOICE_ID_TELUGU=your_telugu_voice_id
ELEVENLABS_VOICE_ID_HINDI=your_hindi_voice_id
ELEVENLABS_VOICE_ID_ENGLISH=your_english_voice_id

# Twilio (for WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Server Configuration
PORT=5000
DEBUG=True
BASE_URL=http://localhost:5000

# For production deployment
# BASE_URL=https://your-app.onrender.com
